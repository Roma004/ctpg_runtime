// Templates by configure_file(@ONLY).
#include <cstdio>
#include <cstdint>
#include <cstddef>
#include <vector>
#include <stdexcept>
#include <string>

#include <ctpg/ctpg.hpp>
#include <ctpg/parse-table.hpp>

#include "@CTPG_HEADER@"

static void write_cpp_array(const char* path,
                            const char* symbol,
                            const char* ns,
                            const std::vector<uint8_t>& blob)
{
    std::FILE* f = std::fopen(path, "wb");
    if (!f) throw std::runtime_error(std::string("cannot open ") + path);

    std::fprintf(f, "// Auto-generated by ctpg. Do not edit.\n");
    std::fprintf(f, "#include <cstddef>\n#include <cstdint>\n\n");

    bool has_ns = (ns && *ns);
    if (has_ns) std::fprintf(f, "namespace %s {\n\n", ns);

    std::fprintf(f, "alignas(64) const unsigned char %s[] = {\n", symbol);
    for (size_t i = 0; i < blob.size(); ++i)
    {
        if (i % 32 == 0) std::fprintf(f, "    ");
        std::fprintf(f, "0x%02x", static_cast<unsigned>(blob[i]));
        if (i + 1 != blob.size()) std::fprintf(f, ",");
        if (i % 32 == 31) std::fprintf(f, "\n");
        else std::fprintf(f, " ");
    }
    std::fprintf(f, "\n};\n\n");
    std::fprintf(f, "const std::size_t %s_size = sizeof(%s);\n", symbol, symbol);

    if (has_ns) std::fprintf(f, "\n} // namespace %s\n", ns);
    std::fclose(f);
}

int main(int argc, char** argv)
{
    if (argc != 3) {
        std::fprintf(stderr, "usage: %s <bin_out> <cpp_out>\n", argv[0]);
        return 1;
    }
    try {
        const auto &table = @CTPG_TABLE@();
        table.save(argv[1]);
        write_cpp_array(argv[2], "@CTPG_SYMBOL@", "@CTPG_NAMESPACE@", table.blob());
        return 0;
    } catch (const std::exception& e) {
        std::fprintf(stderr, "ctpg generator error: %s\n", e.what());
        return 1;
    }
}
